---
import Icon from './Icon.astro';

const NAV = [
  { label: 'About', href: '/' },
  { label: 'Journey', href: '/#journey' },
  { label: 'Ideas', href: '/writing' },
  { label: 'VirtuNx', href: '/#building' },
];
---
<nav class="sticky top-0 z-50 backdrop-blur-md border-b border-transparent bg-paper/70 transition-colors duration-300" data-nav>
  <div class="max-w-page mx-auto px-6 sm:px-8 py-4 flex items-center justify-between">
    <a href="/" class="font-serif text-[18px] font-semibold tracking-tight flex items-center gap-2.5 no-underline text-ink">
      <span class="w-[7px] h-[7px] rounded-full bg-brass inline-block"></span>
      Phanindra Venkata Gottipati
    </a>

    <div class="hidden lg:flex items-center gap-8">
      {NAV.map((l) => (
        <a href={l.href} class="link-underline text-[14px] text-muted hover:text-ink transition-colors">{l.label}</a>
      ))}
      <button data-theme-toggle aria-label="Switch to light theme" class="text-muted hover:text-brass transition-colors">
        <span data-icon="sun"><Icon name="sun" size={16} /></span>
        <span data-icon="moon" style="display:none"><Icon name="moon" size={16} /></span>
      </button>
      <a href="/#connect" class="text-[14px] text-ink border border-line hover:border-brass hover:text-brass px-4 py-2 rounded-[2px] transition-colors">Connect</a>
    </div>

    <div class="lg:hidden flex items-center gap-4">
      <button data-theme-toggle aria-label="Switch to light theme" class="text-muted">
        <span data-icon="sun"><Icon name="sun" size={18} /></span>
        <span data-icon="moon" style="display:none"><Icon name="moon" size={18} /></span>
      </button>
      <button data-menu-toggle aria-label="Open menu" aria-expanded="false" class="text-ink">
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <div data-mobile-menu hidden class="lg:hidden border-t border-line bg-paper px-6 py-4 flex flex-col gap-4">
    {NAV.map((l) => (
      <a href={l.href} class="text-[15px] text-muted hover:text-ink transition-colors">{l.label}</a>
    ))}
    <a href="/#connect" class="text-[15px] text-ink border border-line px-4 py-2 rounded-[2px] text-center">Connect</a>
  </div>
</nav>

<script is:inline>
  // Nav border on scroll (kept minimal; page-level scripts handle theme + menu)
  (function () {
    var nav = document.querySelector('[data-nav]');
    if (!nav) return;
    var onScroll = function () {
      if (window.scrollY > 20) { nav.classList.add('border-line'); nav.classList.remove('border-transparent'); nav.classList.remove('bg-paper/70'); nav.classList.add('bg-paper/85'); }
      else { nav.classList.remove('border-line'); nav.classList.add('border-transparent'); nav.classList.add('bg-paper/70'); nav.classList.remove('bg-paper/85'); }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
